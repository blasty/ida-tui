-def _idatui_tag_map():
-    """{tag character: kind}, built once from whatever this IDA actually has."""
-    import ida_lines
-    out = {}
-    for kind, names in _IDATUI_SPAN_KINDS.items():
-        for n in names:
-            v = getattr(ida_lines, n, None)
-            if isinstance(v, str) and v:
-                out[v[0]] = kind
-            elif isinstance(v, int):
-                out[chr(v)] = kind
-    return out
